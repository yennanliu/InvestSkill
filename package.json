{
  "name": "investskill",
  "version": "1.14.1",
  "description": "Professional investment analysis frameworks for US stock markets — works with Claude Code, Cursor, Gemini CLI, GitHub Copilot, and any AI assistant",
  "main": "scripts/test-skills.js",
  "scripts": {
    "test": "node scripts/test-skills.js && node scripts/check-skill-contract.js --quiet && node scripts/sync-prompts.js --check && node scripts/check-zh-parity.js && node scripts/test-llm-io.js && node scripts/test-edgar.js && node scripts/test-tooling.js && node scripts/test-site.js && node scripts/test-install.js",
    "test:contract": "node scripts/check-skill-contract.js",
    "sync:prompts": "node scripts/sync-prompts.js",
    "sync:prompts:check": "node scripts/sync-prompts.js --check",
    "new:skill": "node scripts/new-skill.js",
    "eval:skills": "node scripts/eval-skills.js",
    "eval:claude": "EVAL_CMD='node scripts/claude-complete.js' node scripts/eval-skills.js",
    "test:llm-io": "node scripts/test-llm-io.js",
    "prompt:diff": "node scripts/prompt-diff.js",
    "prompt:budgets": "node scripts/test-llm-io.js --update-budgets",
    "fetch:edgar": "node scripts/fetch-edgar.js",
    "fetch:fundamentals": "node scripts/fetch-fundamentals.js",
    "test:skills": "node scripts/test-skills.js",
    "test:install": "node scripts/test-install.js",
    "test:edgar": "node scripts/test-edgar.js",
    "validate": "node scripts/validate-prompts.js",
    "validate:prompts": "node scripts/validate-prompts.js",
    "build:site": "node site/build/build-site.js",
    "check:links": "node site/build/build-site.js && node scripts/check-links.js",
    "review": "node scripts/site-review.js",
    "verify": "node scripts/setup-verify.js",
    "verify:setup": "node scripts/setup-verify.js",
    "pre-release-check": "node scripts/pre-release-check.js",
    "pre-release": "node scripts/pre-release-check.js && node scripts/validate-prompts.js && npm test",
    "release": "node scripts/release-interactive.js",
    "release:dry-run": "node scripts/release-dry-run.js",
    "integration-tests": "node scripts/integration-tests.js",
    "integration-tests:verbose": "node scripts/integration-tests.js --verbose",
    "test:tooling": "node scripts/test-tooling.js",
    "test:site": "node scripts/test-site.js",
    "check:zh": "node scripts/check-zh-parity.js"
  },
  "keywords": [
    "investment",
    "stock-analysis",
    "valuation",
    "fundamental-analysis",
    "technical-analysis",
    "portfolio",
    "finance",
    "claude-code",
    "cursor",
    "gemini-cli",
    "github-copilot",
    "prompts"
  ],
  "author": "yennanliu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yennanliu/InvestSkill"
  },
  "homepage": "https://github.com/yennanliu/InvestSkill",
  "bugs": {
    "url": "https://github.com/yennanliu/InvestSkill/issues"
  },
  "devDependencies": {
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^8.6.7"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
